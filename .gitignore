# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Python cache and local tooling output
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# One-shot pipeline artifacts: paper index, batches, backups, fetch state
/website/tools/out/

# Local agent workspace files
.agents/
.codex/

# Repository-local files that are not published to GitHub
/.gitattributes
/AGENTS.md
/RESEARCH_INTERESTS.md
/STYLE_GUIDE.md
# Local reading ideas are kept in the root-level idea/ directory and are not published.
/idea.md
/idea/
/domains/**/idea.md

# Keep links and citations in Git; do not commit publisher PDFs by default.
*.pdf

# The reader bundle reader/data/papers.js IS committed (tsrigo-style
# prebuilt-site deployment); only the raw scratch files stay out of Git.

# local-only site (server, idea-inclusive data, preference log) — never pushed
/website/local/

# local deep-reading notes — never pushed
/notes/

# DeepPaperNote run artifacts
/tmp/
/DeepPaperNote_output/
/skills-lock.json
